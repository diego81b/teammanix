# Copia in apps/api/.env (non versionato) e tieni solo i valori che vuoi cambiare. In sviluppo con Docker il file
# si somma ai default di apps/api/.env.dev e li sovrascrive; DATABASE_URL e PORT li fissa il compose.
DATABASE_URL=postgres://teammanix:devpassword@localhost:5432/teammanix
# Almeno 32 caratteri. Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Durata del JWT di accesso. Non c'è refresh token: alla scadenza si rifà il login.
JWT_EXPIRES_IN=24h
# Origine del frontend, usata nei link delle email (verifica, reset, invito).
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
PORT=3001

# Email transazionali via Brevo. Senza chiave le email vanno solo nel log (vietato in produzione).
BREVO_API_KEY=
# Indirizzo di un dominio autenticato su Brevo (SPF, DKIM). Obbligatorio con la chiave.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TeamManix
