# Copy to apps/api/.env (not versioned) and keep only the values you want to change. In development with Docker the file
# is added to the defaults of apps/api/.env.dev and overrides them; DATABASE_URL and PORT are set by the compose file.
DATABASE_URL=postgres://teammanix:devpassword@localhost:5432/teammanix
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Lifetime of the access JWT. There is no refresh token: on expiry the user logs in again.
JWT_EXPIRES_IN=24h
# Frontend origin, used in email links (verification, reset, invitation).
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
PORT=3001

# Transactional email via Brevo. Without a key, emails are only written to the log (forbidden in production).
BREVO_API_KEY=
# Address on a domain authenticated with Brevo (SPF, DKIM). Required when a key is set.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TeamManix
