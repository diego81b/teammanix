# syntax=docker/dockerfile:1.7
# Immagine di sviluppo: il sorgente arriva da bind mount, nodemon riavvia a ogni modifica.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 3001
# Applica migrazioni e seed, poi avvia in watch. Il db è atteso via healthcheck in compose.
CMD ["sh", "-c", "npm run db:setup && npm run dev"]
