locals {
  name = "${var.project_name}-${var.environment}"
  url  = "https://${var.domain}"

  # The values the compose file requires, minus the ones built here. Empty values are dropped: an optional variable
  # left empty in secrets.json must fall back to the default of the compose file.
  app_env = merge(
    { for k, v in var.secrets : k => v if v != "" },
    {
      DATABASE_URL    = coolify_database_postgresql.db.internal_db_url
      APP_URL         = local.url
      ALLOWED_ORIGINS = local.url
    },
  )
}

resource "coolify_project" "this" {
  name        = local.name
  description = "TeamManix ${var.environment}, managed by OpenTofu (infra/coolify)"
}

resource "coolify_environment" "this" {
  project_uuid = coolify_project.this.uuid
  name         = var.environment
}

resource "coolify_private_key" "deploy" {
  name        = "${local.name}-deploy"
  description = "Read only deploy key of the repository"
  private_key = file(var.deploy_key_file)
}

# The password is generated by Coolify and read back into the (encrypted) state.
resource "coolify_database_postgresql" "db" {
  name             = "${local.name}-db"
  project_uuid     = coolify_project.this.uuid
  server_uuid      = var.server_uuid
  environment_uuid = coolify_environment.this.uuid
  destination_uuid = var.destination_uuid
  image            = "postgres:16-alpine"
  postgres_user    = "teammanix"
  postgres_db      = "teammanix"
  is_public        = false
  instant_deploy   = true
}

resource "coolify_application_private_git" "app" {
  name             = local.name
  project_uuid     = coolify_project.this.uuid
  server_uuid      = var.server_uuid
  environment_uuid = coolify_environment.this.uuid
  destination_uuid = var.destination_uuid

  git_repository   = var.git_repository
  git_branch       = var.git_branch
  private_key_uuid = coolify_private_key.deploy.uuid

  build_pack              = "dockercompose"
  docker_compose_location = "/docker-compose.prod.yml"
  ports_exposes           = "80"

  # The api routes already start with /api, so the proxy must not strip the prefix.
  is_stripprefix_enabled = false
  autogenerate_domain    = false

  # Stage 2 only, see var.domains_enabled.
  docker_compose_domains = var.domains_enabled ? jsonencode([
    { name = "web", domain = local.url },
    { name = "api", domain = "${local.url}/api" },
  ]) : null
}

# One atomic set: every variable not listed here is removed from the application on the next apply.
resource "coolify_envs_bulk" "app" {
  resource_type = "application"
  resource_uuid = coolify_application_private_git.app.uuid
  variables     = local.app_env
}

# Deploys after the variables exist, and again when they or the stage change. Waits for the build: stage 2 needs
# the first deployment finished.
resource "coolify_deployment" "app" {
  application_uuid    = coolify_application_private_git.app.uuid
  wait_for_completion = true

  triggers = {
    env     = nonsensitive(sha256(jsonencode(local.app_env)))
    branch  = var.git_branch
    domains = tostring(var.domains_enabled)
  }

  timeouts = {
    create = "30m"
  }

  depends_on = [coolify_envs_bulk.app]
}
